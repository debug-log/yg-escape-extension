{
  "manifest_version": 3,
  "name": "YG Escpae Extension",
  "version": "1.3.0",
  "description": "등록한 사이트에서 조건에 맞는 XHR JSON 응답을 로컬로 변경합니다.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}